# ================================================
# Tooth Aids - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# ======================
# Application Settings
# ======================
NODE_ENV=production
APP_PORT=9002

# ======================
# MongoDB Configuration
# ======================
# Root credentials for MongoDB (used by docker-compose)
MONGO_ROOT_USERNAME=your_mongo_username
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGO_PORT=27017

# Full MongoDB connection string (used by the application)
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://your_mongo_username:your_secure_mongo_password@mongo:27017/dentalcare?authSource=admin

# ======================
# Admin Seeding
# ======================
# These are used when running: npm run seed:admin
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your_secure_admin_password

# ================================================
# SECURITY NOTES:
# ================================================
# 1. Use strong, unique passwords (min 16 characters recommended)
# 2. Never use default credentials in production
# 3. Rotate credentials periodically
# 4. Keep this file secure and never commit to git
# ================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=your-smtp-password
